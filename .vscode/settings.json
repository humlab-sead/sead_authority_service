{
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#2b4969",
        "activityBar.background": "#2b4969",
        "activityBar.foreground": "#e7e7e7",
        "activityBar.inactiveForeground": "#e7e7e799",
        "activityBarBadge.background": "#170910",
        "activityBarBadge.foreground": "#e7e7e7",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#2b4969",
        "statusBar.background": "#1c3045",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#2b4969",
        "statusBarItem.remoteBackground": "#1c3045",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#1c3045",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#1c304599",
        "titleBar.inactiveForeground": "#e7e7e799",
        "editor.background": "#000000",
        "sideBar.background": "#000000",
        "panel.background": "#000000"
    },
    "peacock.remoteColor": "#1c3045",
    "python.testing.pytestArgs": [
        "tests"
    ],
    
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "pgFormatter.configFile": "${workspaceFolder}/.pg_format",
    "[sql]": {
        "editor.defaultFormatter": "bradymholt.pgformatter"
    },
    "python.analysis.exclude": [
        "bin",
        "data",
        "dist",
        "**/__pycache__",
        ".git",
        "logs",
        "tmp",
        ".venv"
    ],
    "python.analysis.ignore": [
        ".venv"
    ],
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/__pycache__": true
    },
    "markdownlint.ignore": [
        ".github/copilot-instructions.md",
        "AGENTS.md"
    ],
    "github.copilot.chat.diagnostics.ignoreFiles": [
        ".github/copilot-instructions.md",
        "AGENTS.md"
    ],
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.autoFormatStrings": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.displayEnglishDiagnostics": true,
    "python.analysis.generateWithTypeAnnotation": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "python.analysis.typeEvaluation.deprecateTypingAliases": true,
    "yaml.format.printWidth": 120,
    "yaml.schemas": {
        "https://www.schemastore.org/yamllint.json": "file:///home/roger/source/sead_authority_service/src/resources/site.yml"
    }
}